    {
      "cell_type": "code",
      "source": [
        "# NOSOCRATIC Data Handling - NO PANDAS/AI LIBRARIES\n",
        "class NOSOCRATICDataHandler:\n",
        "    def __init__(self, file_path):\n",
        "        self.file_path = file_path\n",
        "\n",
        "    def load_data(self):\n",
        "        if not os.path.exists(self.file_path):\n",
        "            print(f\"NOSOCRATIC: File {self.file_path} does not exist.\")\n",
        "            return []\n",
        "\n",
        "        data = []\n",
        "        with open(self.file_path, 'r') as f:\n",
        "            for line in f:\n",
        "                line = line.strip()\n",
        "                if line and not line.startswith(\"Report Number\") and not line.startswith(\"Business Date\") and not line.startswith(\"Security ID\"):\n",
        "                    # Split the line into columns based on whitespace\n",
        "                    columns = line.split()\n",
        "                    data.append(columns)\n",
        "\n",
        "        if not data:\n",
        "            print(\"NOSOCRATIC: No valid data found in the file.\")\n",
        "            return []\n",
        "\n",
        "        # Simple list-based data structure instead of DataFrame\n",
        "        max_columns = max(len(row) for row in data) if data else 0\n",
        "        structured_data = []\n",
        "        for row in data:\n",
        "            # Pad rows to have consistent length\n",
        "            while len(row) < max_columns:\n",
        "                row.append('0')\n",
        "            structured_data.append({f'column_{i}': row[i] for i in range(len(row))})\n",
        "        \n",
        "        print(f\"NOSOCRATIC: Loaded {len(structured_data)} rows with {max_columns} columns\")\n",
        "        return structured_data\n",
        "\n",
        "    def preprocess_data(self, data):\n",
        "        # NOSOCRATIC: Simple preprocessing without pandas/numpy\n",
        "        if not data:\n",
        "            return data\n",
        "            \n",
        "        # Add labels to data if missing\n",
        "        for i, row in enumerate(data):\n",
        "            if 'label' not in row:\n",
        "                row['label'] = random.randint(0, 1000)  # Simple random label\n",
        "            \n",
        "            # Convert numeric strings to numbers where possible\n",
        "            for key, value in row.items():\n",
        "                if key != 'label':\n",
        "                    try:\n",
        "                        row[key] = float(value)\n",
        "                    except (ValueError, TypeError):\n",
        "                        row[key] = 0.0\n",
        "\n",
        "        print(f\"NOSOCRATIC: Preprocessed {len(data)} rows\")\n",
        "        return data"
      ],
